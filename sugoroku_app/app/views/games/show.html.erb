<h1><%= @game.title %></h1>
<p><%= @game.description %></p>

<% if flash[:notice] %>
  <div style="color: blue; font-weight: bold; margin-bottom: 20px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<h2>プレイヤー一覧</h2>
<ul>
  <% @players.each do |player| %>
    <li>
      <% if player == @current_player && !@is_game_over %>
        <strong><span style="color: red;"><%= player.name %></span></strong>
      <% else %>
        <%= player.name %>
      <% end %>
      - 現在地: <%= player.position %> マス目
      <% if player.is_goal %>（ゴール！）<% elsif player.skip_turns.to_i > 0 %>（おやすみ残り: <%= player.skip_turns %>ターン）<% end %>
    </li>
  <% end %>
</ul>

<% if @is_game_over %>
  <div style="border: 4px solid gold; padding: 20px; text-align: center; margin-bottom: 20px;">
    <h2>ゲーム終了！全員ゴールしました！</h2>
    <%= button_to "最初からやり直す", reset_game_path(@game), method: :post, data: { confirm: "リセットしてもよろしいですか？" } %>
  </div>
<% else %>
  <div style="border: 2px solid green; padding: 10px; margin-bottom: 20px;">
    <h3 style="margin-top: 0;">現在のターン: <%= @current_player.name %></h3>
    <%= button_to "サイコロを振る！", roll_game_path(@game), method: :post %>
    <hr>
    <%= button_to "ゲームをリセットする", reset_game_path(@game), method: :post, form: { style: "display:inline;" }, data: { confirm: "リセットしてもよろしいですか？" } %>
  </div>
<% end %>

<h2>マップ</h2>
<table border="1">
  <tr>
    <th>マス番号</th>
    <th>種類</th>
    <th>テキスト</th>
    <th>効果</th>
    <th>値</th>
  </tr>
  <% @squares.each do |square| %>
    <tr>
      <td><%= square.position %></td>
      <td><%= square.square_type %></td>
      <td><%= square.text %></td>
      <td><%= square.effect %></td>
      <td><%= square.value %></td>
    </tr>
  <% end %>
</table>